# Example environment variables (use VITE_ prefix for Vite builds)

# ID of the root Canvas account (usually 1)
VITE_ROOT_ACCOUNT_ID=1

# Subaccount admin roles (JSON array string)
VITE_SUBACCOUNT_ADMIN_ROLES=[102,103,250]

# Enrolment reports configuration
# Set how many enrolment report buttons you want, then provide name/id pairs.
VITE_NUMBER_ENROL_REPORTS=2
VITE_ENROL_REPORT_NAME_1="Suspended Students"
VITE_ENROL_REPORT_ID_1=129
VITE_ENROL_REPORT_NAME_2="Captioners"
VITE_ENROL_REPORT_ID_2=255

# Optional: other VITE_ variables used by this app (Sentry, etc.)
# VITE_SENTRY_DSN=
# VITE_CANVAS_HOST=
# VITE_TOOL_ID=
